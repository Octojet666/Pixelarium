{
  "id": "/",
  "name": "Pixelarium — Pixel Art Studio",
  "short_name": "Pixelarium",
  "description": "A local-first pixel-art studio: draw, animate, generate and export sprites in your browser or as an installed app.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0b0b10",
  "theme_color": "#0b0b10",
  "lang": "en",
  "dir": "ltr",
  "categories": ["graphics", "design", "productivity"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
